# Pad side of live/modern.k22s (raw evdev values; LY negative = forward).
wait store pad_deadzone
axis LY -3000
wait store pad_forward
axis LY -32767
wait store pad_stop
axis LY 0
wait store pad_turn_walk
axis LY -32767
axis LX 16384
wait store pad_turn_stop
axis LY 0
axis LX 0
wait store pad_turn_place
axis LX 24000
wait store pad_turn_full
axis LX 32767
wait store pad_turn_end
axis LX 0
wait store pad_aim
axis LT 255
wait store pad_fire
axis RT 255 300
wait store pad_lower
axis LT 0
wait store pad_start
press START 150
wait store pad_start_close
press START 150
wait store pad_back
press BACK 150
wait store pad_back_close
press BACK 150
wait store pad_unplug
unplug
wait store pad_plug
plug
wait store pad_replug_forward
axis LY -32767
wait store pad_done
axis LY 0
wait scenario: modern.k22s
