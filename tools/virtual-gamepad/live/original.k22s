# requires: saves, live pad (run-live.sh ... original, no controller.ini)
# Original mode: the pad's raw joystick buttons feed JOY_1..12 (SDL xpad order A=0 B=1 X=2 Y=3 LB=4 ...), read through the
# shipped options.k22 bindings GA_JTuslar aim=1 fire=2 run=3 menu=4 map=5 spell=6 (GenelAyarlar.wdl:111-116):
# A aims, B fires, Y opens the inventory, LB the map. The d-pad doubles as the arrow keys; A/B are not Enter/Esc here
# (Enter while aiming would reload instead of firing, oyuncu2.wdl:2529). No rumble is sent.
pad live
load-save 1
wait until LY_AktifLevelID == 7 && level_yuklendi_ok == 1 && player != 0 && oyuncu_pasif == 0 && oyun_ilk_basladi == 0 && EnvaterAcilabilirmi == 1 timeout 7200
frames 60
assert JOY_1 == 0 && JOY_2 == 0
# d-pad up = Up arrow: walks
store pad_dpad player.x
store y0 player.y
wait until player.x != @pad_dpad || player.y != @y0 timeout 120
frames 30
store pad_dpad_stop player.x
frames 90
# left stick, A6 00422000: joy_force.y = trunc((|raw|-32)*JOY_SENSE*0.02f), clamped to 2*JOY_SENSE; Joy_Takip JOY_Ileri =
# joy_force.y/2 and the walk needs Key_Ileri==1 (oyuncu2.wdl:781), so the stick walks only when saturated (|raw| >= 132 of 255).
# Half forward (LY -13000, raw -102): joy_force.y 1.40, JOY_Ileri 0.70, no walk.
store pad_half player.x
store yh player.y
frames 60
print JOY_Ileri
assert JOY_Ileri > 0.6 && JOY_Ileri < 0.8
assert player.x - @pad_half < 1 && @pad_half - player.x < 1 && player.y - @yh < 1 && @yh - player.y < 1
store pad_half_stop player.x
frames 30
# Full forward (LY -32767, raw -255): joy_force.y 2, JOY_Ileri 1, Key_Ileri 1: walks.
store pad_stick player.x
store y1 player.y
wait until player.x != @pad_stick || player.y != @y1 timeout 120
assert JOY_Ileri == 1
frames 30
store pad_stick_stop player.x
frames 90
# A = JOY_1 = aim, B = JOY_2 = fire
store pad_aim JOY_1
wait until JOY_1 == 1 && silah_kaldir == 1 && player.skill32 >= 100 timeout 600
store ammo S_Kursun_Sayisi[3]
store pad_fire S_Kursun_Sayisi[3]
frames 20
print key_enter
print key_esc
print JOY_2
print Key_Ates
store pad_fire_up S_Kursun_Sayisi[3]
frames 40
print STM_Acik
assert STM_Acik == 0
assert S_Kursun_Sayisi[3] < @ammo
capture original-fired
frames 30
assert EM_Acik == 0 && h_menu_aktifmi == 0
store pad_lower S_Kursun_Sayisi[3]
wait until silah_kaldir == 0 && EnvaterAcilabilirmi == 1 timeout 900
frames 30
# Y = JOY_4 = menu (inventory), LB = JOY_5 = map
store pad_menu EM_Acik
frames 10
print JOY_4
print Key_Menu
print EnvaterAcilabilirmi
print EM_Acik
print STM_Acik
store pad_menu_up EM_Acik
wait until EM_Acik == 1 timeout 300
capture original-y-inventory
frames 30
store pad_menu_close EM_Acik
wait until EM_Acik == 0 && freeze_mode == 0 timeout 300
frames 30
store pad_map h_menu_aktifmi
wait until h_menu_aktifmi == 1 timeout 300
frames 30
store pad_map_close h_menu_aktifmi
wait until h_menu_aktifmi == 0 timeout 300
store pad_done player.x
frames 30
