# Reference comparison with the original: Inzar, Tnel24 (kayit15.sav). Loaded view after the original load menu.
realtime on
#wine: wait-log 1st
#wine: sleep 28
load-save 15
wait until $level == "tnel24.wmb" timeout 7200
#wine: wait-log tnel24.wmb 600
#wine: wait-log Physics 120
frames 900
assert player != 0
capture tnel24_loaded
