# Reference comparison with the original: Ebru, Ev (kayit6.sav). Loaded view after the original load menu.
realtime on
#wine: wait-log 1st
#wine: sleep 28
load-save 6
wait until $level == "ev.wmb" timeout 7200
#wine: wait-log ev.wmb 600
#wine: wait-log Physics 120
frames 900
assert player != 0
capture ev_loaded
