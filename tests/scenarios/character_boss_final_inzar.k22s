# requires: saves
# character: inzar
# Final boss (boss.wmb, Demir's fight) played by Inzar; generated by the character-lock boss generator (docs/CHARACTER_LOCK.md).
# kayit26.sav (Demir, level 84) → bosskoli (100) → boss (101), intro movie skipped. The console's god mode keeps the body alive:
# the harness aims and fires but does not dodge (the boss's fireballs and fire burst), so health is not what is under test.
# Creatures (babayaro, y_idno > 12 → boss_oyun_mode 1) until none is left, then the boss to 1000 → boss_ebru_start, the possessed
# Ebru stands guard, the boss below 500 → ebruboss_ol → gaile_kullan_ok, item 38 used → v_oyunsonu_basla and the ending movie.
realtime off
load-save 26
wait until LY_HedefLevel == 0 && level_yuklendi_ok == 1 && LYP_Fade.visible == 0 timeout 6000
assert LY_AktifLevelID == 84 && Aktif_Player == 0
set LY_AktifLevelID 98
set LY_HedefLevel 100
wait until LY_AktifLevelID == 100 timeout 3000
wait until LY_HedefLevel == 0 && level_yuklendi_ok == 1 && LYP_Fade.visible == 0 timeout 1200
set LY_HedefLevel 101
wait until LY_AktifLevelID == 101 timeout 3000
assert $level == "boss.wmb" && Aktif_Player == 0
assert $character == 2 && $count(oyuncu_koruyucu) == 1
find boss boss_ai
assert @boss.skill1 == 1800 && boss_oyun_mode == 0 && gaile_kullan_ok == 0
wait until $movie timeout 1200
press Escape
wait until oyuncu_pasif == 0 && $movie == 0 && EnvaterAcilabilirmi == 1 timeout 1200
press F10
type god
press Return
press F10
# Inzar outside her story: M opens her spell menu, M again the item inventory, M closes (docs/CHARACTER_LOCK.md).
press M
wait until KOM_Acik == 1 && EM_Acik == 0 && freeze_mode == 1 timeout 120
press M
wait until KOM_Acik == 0 && EM_Acik == 1 && freeze_mode == 1 timeout 120
press M
wait until KOM_Acik == 0 && EM_Acik == 0 && freeze_mode == 0 timeout 120
# Spell 4 (koru_adu_buyu, the ranged bolt) from the spell menu.
press M
wait until KOM_Acik == 1 timeout 120
press-until Right KOM_Cursor == 3 timeout 300
press-until Return KOM_Cursor1 == 0 timeout 120
press-until Return KOM_Acik == 0 timeout 120
assert buyu_no == 4 && freeze_mode == 0
# Creatures.
find n enemy
turn-to @n 60 timeout 600
store g $frame
press-until S @n.skill1 <= 0 || @n.alive == 0 || boss_oyun_mode >= 1 && boss_yarasayi == 0 || $frame > @g + 150 timeout 600
find n enemy
turn-to @n 60 timeout 600
store g $frame
press-until S @n.skill1 <= 0 || @n.alive == 0 || boss_oyun_mode >= 1 && boss_yarasayi == 0 || $frame > @g + 150 timeout 600
