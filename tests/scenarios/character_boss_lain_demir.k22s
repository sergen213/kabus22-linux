capture lain_buyukes_gun_body
# Buyukes autosave after buyukes_koruses (as inzar_lain_boss).
wait until OSN_OtoSave_dizi[14] == 1 timeout 3600
wait until Aktif_SaveNo == 28 timeout 1200
