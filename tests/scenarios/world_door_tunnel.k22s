# requires: saves
# Seamless doors, tunnel pair Tnel24 (39) -> Tnel12 (40), Inzar, original kayit15.sav. The return door to 39 carries FLAG1:
# LY_Tarama refuses it while tunnel enemies remain (LV_HataGoster 11), so no doorway opens and nothing loads.
realtime off
load-save 15
wait until LY_AktifLevelID == 39 && level_yuklendi_ok == 1 && player != 0 && koruyucu_pasif == 0 && LYP_Fade.visible == 0 timeout 7200
store fade $fadeframes
walk-to 98 -238 10 path timeout 1500
walk-to 106 -270 8 timeout 600
turn-to 106 -300 6
press-until D $door == 1 timeout 300
wait until LY_AktifLevelID == 40 timeout 600
wait until $door == 0 timeout 600
assert $level == "tnel12.wmb"
assert harita_anagrup == 3
assert harita_no == 11
assert koruyucu_pasif == 0
assert $doorswaps == 1
assert $fadeframes == @fade
capture tnel12_arrival
turn-to 30 1325 6
press-until D LYT_AltYazi.visible == 1 timeout 600
frames 30
assert $door == 0
assert LY_HedefLevel == 0
assert LY_AktifLevelID == 40
assert $doorswaps == 1
