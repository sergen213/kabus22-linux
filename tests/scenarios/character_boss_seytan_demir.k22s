capture seytan_gun_body_death
wait until Aktif_Player == 1 timeout 3000
# The story switches to Ebru: the prompt pauses the scripts; Return keeps Demir (row 1).
wait until $prompt == 1 timeout 600
press Return
wait until $prompt == -1 timeout 120
# LevelYukle 62 -> 65 plays the Ebru wake-up movie (LevelYonetim.wdl:921, EbruYukle, video_ismi_str20).
wait until $movie timeout 3000
press Escape
wait until LY_AktifLevelID == 65 && level_yuklendi_ok == 1 timeout 3000
assert $level == "ebrudus.wmb"
assert $character == 0 && $count(Oyuncu_Demir) == 1 && $count(oyuncu_koruyucu) == 0
wait until Aktif_Silah >= 1 && Aktif_Silah <= 7 timeout 60
wait until oyuncu_pasif == 0 timeout 1200
frames 120
capture seytan_gun_body_ebrudus
