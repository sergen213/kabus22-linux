press-until D @boss.skill1 <= 0 || player.skill1 <= 0 || Aktif_Player == 1 || $frame > @g + 240 timeout 600
press-until Return S_Kursun_Sayisi[2] > 0 || Kursun_Sayisi[2] == 0 || @boss.skill1 <= 0 || Aktif_Player == 1 timeout 300
up S
