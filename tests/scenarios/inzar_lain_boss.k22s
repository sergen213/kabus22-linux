frames 90
capture inzar_lain_death
wait until lain_sona_erdi == 1 timeout 3000
# Locked (-DCHARACTER=inzar), Kotukoru_Ol's story switch to Demir opens the prompt; Return keeps Inzar (row 1). Unlocked: no prompt.
wait until $prompt != -1 || $character == -1 || LY_AktifLevelID == 84 timeout 3000
press-until Return $prompt == -1 timeout 120
wait until LY_AktifLevelID == 84 && level_yuklendi_ok == 1 && lain_sona_erdi == 2 timeout 3000
assert Aktif_Player == 0
assert $level == "buyukes.wmb"
frames 120
capture inzar_lain_buyukes
# Buyukes otosave_fish (skill1 14, YukleMenu.wdl:417): buyukes_koruses (kotu_koruyucu.wdl:6507) ends its Video_Cam scene with
# OSN_OtoSave_izin=1, so the autosave writes kayit27.sav and kysd.sav (Aktif_SaveNo 27 -> 28). world_otosave_reload loads it.
wait until OSN_OtoSave_dizi[14] == 1 timeout 3600
wait until Aktif_SaveNo == 28 timeout 1200
assert OSN_OtoSave_izin == 0
