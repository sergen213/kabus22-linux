# requires: saves
# Seamless doors with the character lock (docs/SEAMLESS_DOORS.md, docs/CHARACTER_LOCK.md), kizic2 (37) <-> Kizic (36), kayit10.sav.
# A story switch while the doorway is open opens the switch prompt and pauses the door; after the answer the door crosses and the
# seamless swap's load_level places the locked body (Ebru's action on Demir's story level), both ways, without a fade frame.
realtime off
load-save 10
wait until LY_AktifLevelID == 37 && level_yuklendi_ok == 1 && player != 0 && oyuncu_pasif == 0 timeout 7200
wait until oyun_ilk_basladi == 0 timeout 600
press F10
type character inzar
press Return
press F10
frames 4
assert $character == 2 && $prompt == -1
store fade $fadeframes
walk-to -260 25 12 timeout 900
walk-to -420 25 12 timeout 1200
walk-to -455 -48 12 timeout 1200
turn-to -500 -48 6
press-until D $door == 1 timeout 300
# Switch (row 2) to Ebru while the doorway is open: the door waits for the answer.
set Aktif_Player 1
frames 2
assert $prompt == 1 && $door == 1
capture door_prompt
press Down
press Return
frames 4
assert $prompt == -1 && $character == 1
# Back to Demir's story, keep Ebru (row 1).
set Aktif_Player 0
frames 2
assert $prompt == 0
press Return
frames 4
assert $prompt == -1 && $character == 1 && Aktif_Player == 0
wait until $door == 2 timeout 300
wait until LY_AktifLevelID == 36 timeout 600
wait until $door == 0 timeout 600
assert $level == "kizic.wmb"
assert level_yuklendi_ok == 1 && oyuncu_pasif == 0 && player != 0
assert $count(Oyuncu_Ebru) == 1 && $count(Oyuncu_Demir) == 0
assert $doorswaps == 1
assert $fadeframes == @fade
capture kizic_ebru
turn-to -20 -378 4
press-until D $door == 1 timeout 600
wait until LY_AktifLevelID == 37 timeout 600
wait until $door == 0 timeout 600
assert $level == "kizic2.wmb"
assert oyuncu_pasif == 0 && player != 0
assert $count(Oyuncu_Ebru) == 1 && $count(Oyuncu_Demir) == 0
assert $doorswaps == 2
assert $fadeframes == @fade
capture kizic2_ebru
frames 120
assert player != 0
