# requires: saves
# bodies: demir
# Final boss (boss.wmb, Demir's fight) played by Demir (the original, unlocked); generated by the character-lock boss generator (docs/CHARACTER_LOCK.md).
# kayit26.sav (Demir, level 84) → bosskoli (100) → boss (101), intro movie skipped. The console's god mode keeps the body alive:
# the harness aims and fires but does not dodge (the boss's fireballs and fire burst), so health is not what is under test.
# Creatures (babayaro, y_idno > 12 → boss_oyun_mode 1) until none is left, then the boss to 1000 → boss_ebru_start, the possessed
# Ebru stands guard, the boss below 500 → ebruboss_ol → gaile_kullan_ok, item 38 used → v_oyunsonu_basla and the ending movie.
realtime off
load-save 26
wait until LY_HedefLevel == 0 && level_yuklendi_ok == 1 && LYP_Fade.visible == 0 timeout 6000
assert LY_AktifLevelID == 84 && Aktif_Player == 0
set LY_AktifLevelID 98
set LY_HedefLevel 100
wait until LY_AktifLevelID == 100 timeout 3000
wait until LY_HedefLevel == 0 && level_yuklendi_ok == 1 && LYP_Fade.visible == 0 timeout 1200
set LY_HedefLevel 101
wait until LY_AktifLevelID == 101 timeout 3000
assert $level == "boss.wmb" && Aktif_Player == 0
assert $character <= 0 && $count(Oyuncu_Demir) == 1
find boss boss_ai
assert @boss.skill1 == 1800 && boss_oyun_mode == 0 && gaile_kullan_ok == 0
wait until $movie timeout 1200
press Escape
wait until oyuncu_pasif == 0 && $movie == 0 && EnvaterAcilabilirmi == 1 timeout 1200
press F10
type god
press Return
press F10
# Raising and lowering the weapon reopens the inventory gate (oyuncu2.wdl:2162/2894; a cutscene during aim leaves it closed).
down S
frames 40
up S
wait until silah_kaldir == 0 && EnvaterAcilabilirmi == 1 timeout 3000
press-until M EM_Acik == 1 timeout 120
wait until EM_Bolge == 1 && freeze_mode == 1 timeout 300
press Return
wait until EM_Bolge == 2 timeout 300
press Up
press-until Right Silahlar[EM_CursorNesne+EM_NesneKafa] == 2 || Silahlar[EM_CursorNesne+EM_NesneKafa+1] == 2 timeout 600
press-until Down Silahlar[EM_CursorNesne+EM_NesneKafa] == 2 timeout 60
press Return
wait until EM_Bolge == 6 timeout 300
press Return
wait until Aktif_Silah == 2 && EM_Bolge == 2 timeout 300
press M
wait until EM_Acik == 0 && freeze_mode == 0 timeout 300
# Creatures.
find n enemy
turn-to @n 15 timeout 900
store g $frame
down S
wait until silah_kaldir == 1 && player.skill32 >= 100 || $frame > @g + 200 || boss_oyun_mode >= 1 && boss_yarasayi == 0 timeout 300
store g $frame
press-until D @n.skill1 <= 0 || @n.alive == 0 || silah_kaldir == 0 || boss_oyun_mode >= 1 && boss_yarasayi == 0 || $frame > @g + 240 timeout 600
press-until Return S_Kursun_Sayisi[Aktif_Silah] > 0 || Kursun_Sayisi[Aktif_Silah] == 0 || silah_kaldir == 0 || boss_oyun_mode >= 1 && boss_yarasayi == 0 timeout 300
find n enemy
turn-to @n 15 timeout 900
store g $frame
down S
wait until silah_kaldir == 1 && player.skill32 >= 100 || $frame > @g + 200 || boss_oyun_mode >= 1 && boss_yarasayi == 0 timeout 300
store g $frame
