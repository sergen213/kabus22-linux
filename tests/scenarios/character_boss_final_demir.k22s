press-until D S_Kursun_Sayisi[6] < @a || gaile_kullan_ok == 1 || @boss.skill1 < 500 timeout 300
# Stand until it has gone off: the 3 s fuse (silah.wdl elbombasi_gonder, locbomba_time) outlasts a short wait, and Demir walking
# onto a live grenade of his own takes 1200/12 = 100 at point blank (oyuncu2.wdl player_Tarama), a one-frame death god cannot undo.
wait until $count(elbombasi_gonder) == 0 timeout 400
print @boss.skill1
up S
frames 10
walk-to 100 60 30 path timeout 3000
turn-to @boss 3 timeout 900
down S
wait until silah_kaldir == 1 && player.skill32 >= 100 || gaile_kullan_ok == 1 || @boss.skill1 < 500 timeout 300
store a S_Kursun_Sayisi[6]
press-until D S_Kursun_Sayisi[6] < @a || gaile_kullan_ok == 1 || @boss.skill1 < 500 timeout 300
# Stand until it has gone off: the 3 s fuse (silah.wdl elbombasi_gonder, locbomba_time) outlasts a short wait, and Demir walking
# onto a live grenade of his own takes 1200/12 = 100 at point blank (oyuncu2.wdl player_Tarama), a one-frame death god cannot undo.
wait until $count(elbombasi_gonder) == 0 timeout 400
print @boss.skill1
wait until gaile_kullan_ok == 1 timeout 6000
print $frame
# The end: item 38 used where v_oyunsonu_ctrl waits (Ornek_Yasin.wdl v_oyunsonu_Tarama:3644) → v_oyunsonu_basla → the movie.
find v v_oyunsonu_ctrl
up S
up Q
walk-to 118 51 30 path timeout 3000
assert $dist(@v) < 60
store n NS_NesneSayisi
down S
frames 40
up S
wait until silah_kaldir == 0 && EnvaterAcilabilirmi == 1 && oyuncu_pasif == 0 timeout 3000
press-until M EM_Acik == 1 timeout 120
wait until EM_Bolge == 1 && freeze_mode == 1 timeout 300
press-until Down EM_CursorSiNeDo == 1 timeout 120
press Return
wait until EM_Bolge == 3 timeout 300
press Up
press-until Right NS_Nesneler[EM_CursorNesne+EM_NesneKafa] == 38 || NS_Nesneler[EM_CursorNesne+EM_NesneKafa+1] == 38 timeout 1200
press-until Down NS_Nesneler[EM_CursorNesne+EM_NesneKafa] == 38 timeout 60
press Return
wait until EM_Bolge == 7 && EM_CursorKuBiGo == 0 timeout 300
press Return
wait until $movie && oyuncu_pasif == 1 timeout 1200
assert NS_NesneSayisi == @n - 1 && gaile_kullan_ok == 1
print $frame
wait until $movie == 0 timeout 30000
wait until Menu_Acilis.visible == 1 timeout 1200
print $frame
