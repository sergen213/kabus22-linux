# Demir: the possessed Ebru steps into every shot at the boss (silah.wdl:546-558): grenades past her (hedef.wdl:59).
# Raising and lowering the weapon reopens the inventory gate (oyuncu2.wdl:2162/2894; a cutscene during aim leaves it closed).
down S
frames 40
up S
wait until silah_kaldir == 0 && EnvaterAcilabilirmi == 1 timeout 3000
press-until M EM_Acik == 1 timeout 120
wait until EM_Bolge == 1 && freeze_mode == 1 timeout 300
press Return
wait until EM_Bolge == 2 timeout 300
press Up
press-until Right Silahlar[EM_CursorNesne+EM_NesneKafa] == 6 || Silahlar[EM_CursorNesne+EM_NesneKafa+1] == 6 timeout 600
press-until Down Silahlar[EM_CursorNesne+EM_NesneKafa] == 6 timeout 60
press Return
wait until EM_Bolge == 6 timeout 300
press Return
wait until Aktif_Silah == 6 && EM_Bolge == 2 timeout 300
press M
wait until EM_Acik == 0 && freeze_mode == 0 timeout 300
