frames 120
up S
wait until silah_kaldir == 0 && EnvaterAcilabilirmi == 1 timeout 900
# weapon 7: inventory slot 5
press M
wait until EM_Acik == 1 && EM_Bolge == 1 && freeze_mode == 1 timeout 300
press Return
wait until EM_Bolge == 2 timeout 300
press Down
press-until Right EM_CursorNesne+EM_NesneKafa >= 5 timeout 600
press-until Left EM_CursorNesne+EM_NesneKafa <= 5 timeout 600
