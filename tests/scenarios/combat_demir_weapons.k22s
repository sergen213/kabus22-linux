wait until silah_kaldir == 0 && EnvaterAcilabilirmi == 1 timeout 900
# weapon 5: inventory slot 11
press M
wait until EM_Acik == 1 && EM_Bolge == 1 && freeze_mode == 1 timeout 300
press Return
wait until EM_Bolge == 2 timeout 300
press Down
press-until Right EM_CursorNesne+EM_NesneKafa >= 11 timeout 600
press-until Left EM_CursorNesne+EM_NesneKafa <= 11 timeout 600
assert Silahlar[11] == 5
press Return
wait until EM_Bolge == 6 timeout 300
press Return
wait until Aktif_Silah == 5 && EM_Bolge == 2 timeout 300
press M
wait until EM_Acik == 0 && freeze_mode == 0 timeout 300
down S
wait until silah_kaldir == 1 && player.skill32 >= 100 timeout 600
store ammo5 S_Kursun_Sayisi[5]
press D 8
wait until S_Kursun_Sayisi[5] < @ammo5 timeout 300
frames 20
capture demir_agir_fired
store fired5 S_Kursun_Sayisi[5]
store reserve5 Kursun_Sayisi[5]
press-until Return S_Kursun_Sayisi[5] > @fired5 timeout 600
assert S_Kursun_Sayisi[5] == Silah_Kapasite[5]
assert S_Kursun_Sayisi[5] + Kursun_Sayisi[5] == @fired5 + @reserve5
up S
wait until silah_kaldir == 0 && EnvaterAcilabilirmi == 1 timeout 900
# weapon 6: inventory slot 7
press M
wait until EM_Acik == 1 && EM_Bolge == 1 && freeze_mode == 1 timeout 300
press Return
wait until EM_Bolge == 2 timeout 300
press Down
press-until Right EM_CursorNesne+EM_NesneKafa >= 7 timeout 600
press-until Left EM_CursorNesne+EM_NesneKafa <= 7 timeout 600
assert Silahlar[7] == 6
press Return
wait until EM_Bolge == 6 timeout 300
press Return
wait until Aktif_Silah == 6 && EM_Bolge == 2 timeout 300
press M
wait until EM_Acik == 0 && freeze_mode == 0 timeout 300
down S
wait until silah_kaldir == 1 && player.skill32 >= 100 timeout 600
store ammo6 S_Kursun_Sayisi[6]
press D 8
wait until S_Kursun_Sayisi[6] < @ammo6 timeout 300
frames 20
