wait until EM_Bolge == 6 timeout 300
press Return
wait until Aktif_Silah == 4 && EM_Bolge == 2 timeout 300
press M
wait until EM_Acik == 0 && freeze_mode == 0 timeout 300
down S
wait until silah_kaldir == 1 && player.skill32 >= 100 timeout 600
store ammo4 S_Kursun_Sayisi[4]
press D 8
wait until S_Kursun_Sayisi[4] < @ammo4 timeout 300
frames 20
capture demir_akrep_fired
