# requires: saves
# bodies: demir (grenades and mines are thrown by Demir's action only; docs/CHARACTER_LOCK.md rule 3)
# Demir's arsenal at Tüneller (slot 12 = kayit11.sav, 12 inventory entries). Every weapon is selected through the original
# inventory: M → Silahlar → weapon → Kullan (Envantermenu.wdl EM_TusKontrol/EM_Kernel, NesneMenu.wdl EM_NesneSiMenu, KuBiGoMenu.wdl:40-49).
# Firearms: hold S (raise, oyuncu2.wdl:2108-2196), D fires (silah.wdl Ates_Et:533 S_Kursun_Sayisi-=1), Enter reloads from the
# reserve (oyuncu2.wdl:2529 → silah.wdl Oy_Kursun_Doldur). Grenade/mine: D throws/places (oyuncu2.wdl:2555ff). S+Q kicks (oyuncu2.wdl:2240).
# The inventory only opens after EM_Kernel's post-load delay (oyun_ilk_basladi → 0) and while the weapon is lowered (EnvaterAcilabilirmi).
realtime off
load-save 11
wait until LY_AktifLevelID == 41 && level_yuklendi_ok == 1 && player != 0 && oyuncu_pasif == 0 && EnvaterAcilabilirmi == 1 && oyun_ilk_basladi == 0 timeout 7200
assert SilahSayisi == 12
# weapon 1: inventory slot 0
press M
wait until EM_Acik == 1 && EM_Bolge == 1 && freeze_mode == 1 timeout 300
press Return
wait until EM_Bolge == 2 timeout 300
press Up
press-until Right EM_CursorNesne+EM_NesneKafa >= 0 timeout 600
press-until Left EM_CursorNesne+EM_NesneKafa <= 0 timeout 600
assert Silahlar[0] == 1
press Return
wait until EM_Bolge == 6 timeout 300
press Return
wait until Aktif_Silah == 1 && EM_Bolge == 2 timeout 300
press M
wait until EM_Acik == 0 && freeze_mode == 0 timeout 300
down S
wait until silah_kaldir == 1 && player.skill32 >= 100 timeout 600
store ammo1 S_Kursun_Sayisi[1]
press D 8
wait until S_Kursun_Sayisi[1] < @ammo1 timeout 300
frames 20
capture demir_pistol_fired
store fired1 S_Kursun_Sayisi[1]
store reserve1 Kursun_Sayisi[1]
press-until Return S_Kursun_Sayisi[1] > @fired1 timeout 600
assert S_Kursun_Sayisi[1] == Silah_Kapasite[1]
assert S_Kursun_Sayisi[1] + Kursun_Sayisi[1] == @fired1 + @reserve1
up S
wait until silah_kaldir == 0 && EnvaterAcilabilirmi == 1 timeout 900
# weapon 3: inventory slot 2
press M
wait until EM_Acik == 1 && EM_Bolge == 1 && freeze_mode == 1 timeout 300
press Return
wait until EM_Bolge == 2 timeout 300
press Up
press-until Right EM_CursorNesne+EM_NesneKafa >= 2 timeout 600
press-until Left EM_CursorNesne+EM_NesneKafa <= 2 timeout 600
assert Silahlar[2] == 3
press Return
wait until EM_Bolge == 6 timeout 300
press Return
wait until Aktif_Silah == 3 && EM_Bolge == 2 timeout 300
press M
wait until EM_Acik == 0 && freeze_mode == 0 timeout 300
down S
wait until silah_kaldir == 1 && player.skill32 >= 100 timeout 600
store ammo3 S_Kursun_Sayisi[3]
press D 8
wait until S_Kursun_Sayisi[3] < @ammo3 timeout 300
frames 20
capture demir_machinegun_fired
store fired3 S_Kursun_Sayisi[3]
store reserve3 Kursun_Sayisi[3]
press-until Return S_Kursun_Sayisi[3] > @fired3 timeout 600
assert S_Kursun_Sayisi[3] == Silah_Kapasite[3]
assert S_Kursun_Sayisi[3] + Kursun_Sayisi[3] == @fired3 + @reserve3
up S
wait until silah_kaldir == 0 && EnvaterAcilabilirmi == 1 timeout 900
# weapon 2: inventory slot 6
press M
wait until EM_Acik == 1 && EM_Bolge == 1 && freeze_mode == 1 timeout 300
press Return
wait until EM_Bolge == 2 timeout 300
press Up
press-until Right EM_CursorNesne+EM_NesneKafa >= 6 timeout 600
press-until Left EM_CursorNesne+EM_NesneKafa <= 6 timeout 600
assert Silahlar[6] == 2
press Return
wait until EM_Bolge == 6 timeout 300
press Return
wait until Aktif_Silah == 2 && EM_Bolge == 2 timeout 300
press M
wait until EM_Acik == 0 && freeze_mode == 0 timeout 300
down S
wait until silah_kaldir == 1 && player.skill32 >= 100 timeout 600
store ammo2 S_Kursun_Sayisi[2]
press D 8
wait until S_Kursun_Sayisi[2] < @ammo2 timeout 300
frames 20
capture demir_shotgun_fired
store fired2 S_Kursun_Sayisi[2]
store reserve2 Kursun_Sayisi[2]
press-until Return S_Kursun_Sayisi[2] > @fired2 timeout 600
assert S_Kursun_Sayisi[2] == Silah_Kapasite[2]
assert S_Kursun_Sayisi[2] + Kursun_Sayisi[2] == @fired2 + @reserve2
up S
wait until silah_kaldir == 0 && EnvaterAcilabilirmi == 1 timeout 900
# weapon 4: inventory slot 9
press M
wait until EM_Acik == 1 && EM_Bolge == 1 && freeze_mode == 1 timeout 300
press Return
wait until EM_Bolge == 2 timeout 300
press Down
press-until Right EM_CursorNesne+EM_NesneKafa >= 9 timeout 600
press-until Left EM_CursorNesne+EM_NesneKafa <= 9 timeout 600
