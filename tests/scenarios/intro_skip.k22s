# Native convenience (Engine::skip_intro): Return during the startup logos (K22.wdl Menu_AcilisEkrani, ~15 s, no skip in A6)
# fast-forwards to the menu without the press reaching it; Space skips the New Game intro and Return the Start4 entry movie
# (the original scripts only test key_esc there).
realtime off
wait until Menu_Acilis.visible == 1 timeout 900
frames 30
store skipframe $frame
press Return
wait until ParlaklikMenuAcik == 1 || AMP_YeniOyun.visible == 1 timeout 120
assert $frame < @skipframe + 120
frames 30
# The Return that skipped the logos did not dismiss the brightness menu or select a main-menu item.
assert ParlaklikMenuAcik == 1 || AM_Cursor == 0 && AMP_YeniOyun.visible == 1
press-until Return ParlaklikMenuAcik == 0
wait until AMP_YeniOyun.visible == 1 && AM_Cursor == 0 timeout 600
press-until Return YM_Cursor == 0 && YMP_Normal.visible == 1 timeout 120
press Return
frames 300
store introframe $frame
press Space
wait until oyun_ilk_basladi == 1 timeout 600
assert $frame < @introframe + 600
wait until $level == "start4.wmb" && $movie == 1 timeout 7200
frames 60
press Return
wait until $movie == 0 timeout 30
# LevelYukle plays the intro movie and then the Start4 entry movie (LevelYonetim.wdl video_ismi_str16/str17).
press-until Return $movie == 0 && LY_AktifLevelID == 1 && level_yuklendi_ok == 1 && player != 0 timeout 1200
wait until LY_AktifLevelID == 1 && level_yuklendi_ok == 1 && player != 0 && oyuncu_pasif == 0 timeout 3600
