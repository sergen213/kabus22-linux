# requires: saves
# Native quicksave/quickload (docs/CONSOLE.md): F5 writes the next slot of the original save list through the original
# SLG_LevelKaydet/YD_OyunuKaydet/SLG_Kaydet and adds the player position to the slot sidecar; F9 loads the newest slot through
# Yukleme_Kontrol and puts the player back where it was saved. Demir, kizic2 (level 37), from original kayit10.sav.
# Continued by quicksave2_restart in the same private installation.
realtime off
load-save 10
wait until LY_AktifLevelID == 37 && level_yuklendi_ok == 1 && player != 0 && oyuncu_pasif == 0 timeout 7200
assert Aktif_SaveNo == 27
wait until oyun_ilk_basladi == 0 timeout 600
walk-to -260 25 12 timeout 900
store x player.x
store y player.y
store z player.z
store pan player.pan
store ammo S_Kursun_Sayisi[1]
store saves aktif_kayit_sayisi
print player.x
print player.y
press F5
assert Aktif_SaveNo == 28
assert aktif_kayit_sayisi == @saves + 1
# Change position and state, then quickload.
walk-to -420 25 12 timeout 1200
set S_Kursun_Sayisi[1] 0
assert player.x < @x - 100
press F9
wait until LY_AktifLevelID == 0 timeout 60
wait until LY_AktifLevelID == 37 && level_yuklendi_ok == 1 && oyuncu_pasif == 0 timeout 3600
frames 2
assert player.x > @x - 1 && player.x < @x + 1
assert player.y > @y - 1 && player.y < @y + 1
assert player.z > @z - 2 && player.z < @z + 2
assert player.pan > @pan - 1 && player.pan < @pan + 1
assert S_Kursun_Sayisi[1] == @ammo
assert Aktif_SaveNo == 28
# Still playable after the load: walk away from the restored spot.
walk-to -420 25 12 timeout 1200
# Refused outside gameplay: the inventory menu (freeze_mode) blocks F5.
press M
wait until freeze_mode == 1 timeout 120
press F5
assert Aktif_SaveNo == 28
press-until M freeze_mode == 0 timeout 120
wait until freeze_mode == 0 timeout 300
