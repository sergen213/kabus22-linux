# Start4 spawn yard: the lying corpses (ol_ask1/ol_ask4.mdl, no PASSABLE/POLYGON) must not block the direct southward path.
# A6 00435730 squares a model's XY box and halves its excess over +-16 (reverse/wave2/GameplayWorld/K22.exe.00435730.asm.txt):
# ol_ask4 at (-1308,486) spans x -1330..-1277, which with Demir's script box (oyuncu2.wdl min_x -11) leaves the spawn line x=-1346 free.
# Before that fix the raw MDL box (x -1339..-1263) stopped Demir at y~515 (CONTRACT.txt:2313).
realtime off
wait until ParlaklikMenuAcik == 1 || AMP_YeniOyun.visible == 1 timeout 3600
press-until Return ParlaklikMenuAcik == 0
wait until AMP_YeniOyun.visible == 1 && AM_Cursor == 0 timeout 600
press-until Return YM_Cursor == 0 && YMP_Normal.visible == 1 timeout 120
realtime on
press Return
frames 120
press Escape
wait until oyun_ilk_basladi == 1 timeout 1800
wait until $level == "start4.wmb" timeout 7200
frames 120
press Escape
wait until LY_AktifLevelID == 1 && level_yuklendi_ok == 1 && player != 0 timeout 3600
realtime off
wait until oyuncu_pasif == 0 timeout 3600
frames 30
assert player.x < -1340 && player.x > -1350
assert player.pan > 269 && player.pan < 271
capture start4_spawn
# Straight south (pan 270) past ol_ask4 (y 438..492) and ol_ask1 (y 423..475).
down Up
frames 300
up Up
frames 10
print player.x
print player.y
assert player.y < 420
capture start4_south_of_corpses
