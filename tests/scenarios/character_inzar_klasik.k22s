# requires: saves
# character: inzar
# Inzar outside her story vs Demir's enemies (docs/CHARACTER_LOCK.md rule 11): a klasik_yaratik (lucifer) at Start5, reached from
# kayit1.sav (cam1) with the console's `level 3`; `god` keeps her alive. Its hit reaction (klasik_yara.wdl Klasik_Yaralan) waits for
# a firearm kind in skill3; Inzar's sword writes 10-30, so it stayed in Yrt_Yaralan (7) for good, even below 0 Enerji. Locked, it
# gets kind 1 (stagger, Yrt_Yaralan_T 16), walks again (Yrt_Yuru 2) and dies (Yrt_ol 9).
realtime off
load-save 1
wait until LY_AktifLevelID == 7 && level_yuklendi_ok == 1 && player != 0 timeout 7200
wait until oyuncu_pasif == 0 && koruyucu_pasif == 0 timeout 1200
press F10
type god
press Return
type level 3
press Return
press F10
wait until LY_AktifLevelID == 3 timeout 3000
wait until LY_HedefLevel == 0 && level_yuklendi_ok == 1 && player != 0 && koruyucu_pasif == 0 timeout 3000
assert $level == "start5.wmb" && $character == 2
find n klasik_yaratik
assert @n.skill1 > 0
walk-to @n 120 path timeout 3000
wait until @n.invisible == 0 && $dist(@n) < 150 timeout 1800
store k0 aktif_oldurme_sayisi
turn-to @n 20 timeout 300
press-until S @n.skill1 < 100 timeout 600
frames 120
assert @n.skill21 != 7
turn-to @n 20 timeout 300
store g $frame
press-until S @n.skill1 <= 0 || @n.alive == 0 || $frame > @g + 300 timeout 900
turn-to @n 20 timeout 300
store g $frame
press-until S @n.skill1 <= 0 || @n.alive == 0 || $frame > @g + 300 timeout 900
turn-to @n 20 timeout 300
store g $frame
press-until S @n.skill1 <= 0 || @n.alive == 0 || $frame > @g + 300 timeout 900
turn-to @n 20 timeout 300
store g $frame
press-until S @n.skill1 <= 0 || @n.alive == 0 || $frame > @g + 300 timeout 900
turn-to @n 20 timeout 300
store g $frame
press-until S @n.skill1 <= 0 || @n.alive == 0 || $frame > @g + 300 timeout 900
wait until @n.skill21 == 9 || @n.alive == 0 timeout 300
