# gameplay_scenarios CTest driver: cmake -DK22=kabus22 -DGAME=GAME_ROOT [-DSAVES=WINDOWS_GAME_DIR] -DSCENARIOS=DIR -DOUT=DIR -P run.cmake
# Every scenario runs headless in a fresh private XDG tree. "# requires: saves" scenarios need the original Windows save set.
# "# continues: OTHER" reuses OTHER's tree without a fresh import (a restart of the same installation); OTHER must sort first.
# "# mode: bonus" runs the Bonus game (--mode bonus --data "GAME_ROOT/Kabus 22 Mode").
file(GLOB scenarios "${SCENARIOS}/*.k22s")
list(SORT scenarios)
set(failed "")
foreach(scenario IN LISTS scenarios)
  get_filename_component(name "${scenario}" NAME_WE)
  file(READ "${scenario}" text)
  if(text MATCHES "# requires: saves" AND NOT SAVES)
    message(STATUS "SKIP ${name}: needs -DK22_ORIGINAL_SAVES")
    continue()
  endif()
  if(text MATCHES "# continues: ([A-Za-z0-9_]+)")
    set(root "${OUT}/${CMAKE_MATCH_1}")
    if(NOT EXISTS "${root}/data")
      message(FATAL_ERROR "${name} continues ${CMAKE_MATCH_1}, which has not run")
    endif()
  else()
    set(root "${OUT}/${name}")
    file(REMOVE_RECURSE "${root}")
    file(MAKE_DIRECTORY "${root}/data" "${root}/config" "${root}/state" "${root}/runtime")
    file(CHMOD "${root}/runtime" DIRECTORY_PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
  endif()
  set(ENV{XDG_DATA_HOME} "${root}/data")
  set(ENV{XDG_CONFIG_HOME} "${root}/config")
  set(ENV{XDG_STATE_HOME} "${root}/state")
  set(ENV{XDG_RUNTIME_DIR} "${root}/runtime")
  if(SAVES AND NOT text MATCHES "# continues: ")
    execute_process(COMMAND "${K22}" --import-saves "${SAVES}" --data "${GAME}" RESULT_VARIABLE code OUTPUT_QUIET)
    if(NOT code EQUAL 0)
      message(FATAL_ERROR "save import failed for ${name}")
    endif()
  endif()
  set(data "${GAME}")
  set(mode "")
  if(text MATCHES "# mode: bonus")
    set(data "${GAME}/Kabus 22 Mode")
    set(mode --mode bonus)
  endif()
  execute_process(COMMAND "${K22}" --data "${data}" ${mode} --headless --scenario "${scenario}" --scenario-out "${root}/out-${name}"
    RESULT_VARIABLE code OUTPUT_FILE "${root}/log-${name}.txt" ERROR_FILE "${root}/stderr-${name}.txt" TIMEOUT 1800)
  file(STRINGS "${root}/log-${name}.txt" summary REGEX "^scenario: [^ ]+\\.k22s ")
  message(STATUS "${summary}")
  if(NOT code EQUAL 0)
    list(APPEND failed "${name}")
    file(STRINGS "${root}/log-${name}.txt" failures REGEX " FAIL ")
    foreach(line IN LISTS failures)
      message(STATUS "  ${line}")
    endforeach()
  endif()
endforeach()
if(failed)
  message(FATAL_ERROR "failed scenarios: ${failed} (logs under ${OUT})")
endif()
