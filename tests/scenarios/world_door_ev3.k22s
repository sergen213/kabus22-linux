# requires: saves
# Seamless doors, Ev3 (99) -> Ev2 (28), Demir: ev2.wmb has no LY_Kapi back to 99, so the doorway on the far side is the wall behind
# the original LV_Ev2_Giris arrival LY_Ev2_G99. Ev3 is reached like the level sweep (from 28, original fade), then the door is used.
realtime off
load-save 8
wait until LY_HedefLevel == 0 && level_yuklendi_ok == 1 && LYP_Fade.visible == 0 timeout 6000
set LY_AktifLevelID 28
set LY_HedefLevel 99
wait until LY_AktifLevelID == 99 && level_yuklendi_ok == 1 && LYP_Fade.visible == 0 && oyuncu_pasif == 0 timeout 3000
assert $level == "ev3.wmb"
assert $doorswaps == 0
store fade $fadeframes
turn-to 72 -369 6
press-until D $door == 1 timeout 300
wait until LY_AktifLevelID == 28 timeout 600
wait until $door == 0 timeout 600
assert $level == "ev2.wmb"
assert level_yuklendi_ok == 1
assert harita_anagrup == 0
assert harita_no == 24
assert oyuncu_pasif == 0
assert $doorswaps == 1
assert $fadeframes == @fade
capture ev2_arrival
frames 120
assert player != 0
