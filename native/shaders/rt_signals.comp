// Actor shadows on lightmapped surfaces (the A6 planar shadow's replacement). The lightmaps already hold the static light
// and its world shadows, so only models with the original SHADOW flag (TLAS mask 4) are traced, toward the lights of
// render_policy::actor_shadow_lights (baked WMB and native point/spot lights whose range holds a caster, and the sun),
// toward a point jittered within clamp(0.005 range, 0.5, 2) units (lamp bulbs are small: the 2-12 unit soft-shadow sphere
// blurred a body's shadow away a few metres from it). Weight: luma x N.L x falloff (baked: linear 1 - d/range; native: its D3D
// attenuation and cone; sun: 1), at most 1. A blocked baked light counts only where the level geometry lets it reach the
// receiver (else the lightmap holds none of it); the sun counts only there at all, so indoor levels get no sun shadow.
// Darkness = SHADOW_ALPHA x min(occluded weight / strongest weight, 1): blocking the receiver's dominant light darkens it
// like the original planar shadow, a weaker light gives a proportionally lighter shadow, and the shadow fades where even
// the strongest light is faint (weight 0.02). Per pixel and frame: the dominant light, one other light picked in proportion
// to its weight (it stands for all the others), and the sun. Each caster that darkened a pixel by at least half of
// SHADOW_ALPHA counts it in casterPixels (per TLAS instance), which decides on the CPU whether its planar shadow is replaced.
layout(set=0,binding=21,std430) buffer CasterPixels { uint casterPixels[]; };
float actorWeight(int i,vec3 p,vec3 n,out vec3 L){
    vec4 a=lightData[i*5],b=lightData[i*5+1],d=lightData[i*5+2],e=lightData[i*5+3],c=lightData[i*5+4];
    vec3 delta=a.xyz-p;float distance=length(delta),attenuation=1.0;L=d.w==3.0?-d.xyz:delta/max(distance,0.0001);
    if(d.w!=3.0&&b.a<0.0)attenuation=max(1.0-distance/max(a.w,0.0001),0.0);
    else if(d.w!=3.0){attenuation=distance<=a.w?1.0/max(e.x+e.y*distance+e.z*distance*distance,0.0001):0.0;
        if(d.w==2.0){float rho=dot(-L,d.xyz);attenuation*=rho>=c.x?1.0:rho<=c.y?0.0:pow((rho-c.y)/max(c.x-c.y,0.0001),e.w);}}
