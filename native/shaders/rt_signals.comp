layout(set=0,binding=2) uniform sampler2D gDepth;
layout(set=0,binding=3) uniform sampler2D gData;
layout(set=0,binding=10,rgba16f) uniform writeonly image2D outMask;
layout(set=0,binding=11,rgba16f) uniform writeonly image2D outGi;
layout(set=0,binding=12,rgba16f) uniform writeonly image2D outReflect;
