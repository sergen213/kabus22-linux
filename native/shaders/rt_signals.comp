// Screen-space ray-traced signals of the primary view, one stochastic sample per pixel and frame:
// soft shadows (area sun/point/spot lights, actor shadows, baked-light shadows on models), ambient occlusion, one-bounce
// diffuse GI and roughness-aware reflections. rt_filter.comp accumulates and denoises them; scene.frag consumes them.
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0,std140) uniform Signals { mat4 inverseViewProjection,previousViewProjection; vec4 eye,sun,params,camera; ivec4 config; vec4 actor,planar; } g;
