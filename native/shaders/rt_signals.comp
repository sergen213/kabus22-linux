            if(roughness>0.02){float a=roughness*roughness,u=rnd(),phi=6.2831853*rnd(),cosTheta=sqrt((1.0-u)/(1.0+(a*a-1.0)*u)),sinTheta=sqrt(1.0-cosTheta*cosTheta);vec3 h=basis(n)*vec3(sinTheta*cos(phi),sinTheta*sin(phi),cosTheta);R=reflect(-V,h);if(dot(R,n)<=0.0)R=reflect(-V,n);}
            reflection=reflectionLayers(p,normalize(R),g.eye.w);
        }
    }
    if((g.config.x&1)!=0)imageStore(outMask,pixel,mask);
    if((g.config.x&2)!=0)imageStore(outGi,pixel,gi);
    if((g.config.x&4)!=0)imageStore(outReflect,pixel,reflection);
}
