    while(rayQueryProceedEXT(q))if(rayQueryGetIntersectionTypeEXT(q,false)==gl_RayQueryCandidateIntersectionTriangleEXT&&!rtAdditive(rayQueryGetIntersectionInstanceCustomIndexEXT(q,false),rayQueryGetIntersectionGeometryIndexEXT(q,false))&&rtHitColor(q,false).a>=0.5)rayQueryConfirmIntersectionEXT(q);
    return rayQueryGetIntersectionTypeEXT(q,true)!=gl_RayQueryCommittedIntersectionNoneEXT?int(rayQueryGetIntersectionInstanceCustomIndexEXT(q,true)):-1;
}
// A point/spot light blocked by a caster: the caster instance, else -1. A baked light must also pass the level geometry;
// native lights are D3D hardware lights that shine through walls (and often sit in wall fixtures, as in ev), so they need not.
