#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_nonuniform_qualifier : require
// Screen-space ray-traced signals of the primary view, one stochastic sample per pixel and frame:
// soft shadows (area sun/point/spot lights + contact shadows from models), one-bounce diffuse GI and
// roughness-aware reflections. rt_filter.comp accumulates and denoises them; scene.frag consumes them.
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0,std140) uniform Signals { mat4 inverseViewProjection,previousViewProjection; vec4 eye,sun,params,camera; ivec4 config; } g;
// eye: xyz position, w far; sun: xyz direction, w angular radius (rad); params: x frame, y GI distance, z contact distance, w near;
// camera: xyz forward, w light count; config: x signal bits (1 shadows, 2 GI, 4 reflections), yz size, w history valid.
layout(set=0,binding=1,std430) readonly buffer Lights { vec4 lightData[]; };
#include "ray_query.glsl"
layout(set=0,binding=2) uniform sampler2D gDepth;
layout(set=0,binding=3) uniform sampler2D gData;
layout(set=0,binding=10,rgba16f) uniform writeonly image2D outMask;
layout(set=0,binding=11,rgba16f) uniform writeonly image2D outGi;
layout(set=0,binding=12,rgba16f) uniform writeonly image2D outReflect;
uint seed;
uint pcg(uint v){uint s=v*747796405u+2891336453u;uint w=((s>>((s>>28u)+4u))^s)*277803737u;return (w>>22u)^w;}
float rnd(){seed=pcg(seed);return float(seed)*(1.0/4294967296.0);}
vec3 linear(vec3 c){return pow(max(c,vec3(0)),vec3(2.2));}
float luma(vec3 c){return dot(c,vec3(0.299,0.587,0.114));}
vec3 decodeNormal(vec2 o){vec3 n=vec3(o,1.0-abs(o.x)-abs(o.y));if(n.z<0.0)n.xy=(1.0-abs(n.yx))*vec2(n.x>=0.0?1.0:-1.0,n.y>=0.0?1.0:-1.0);return normalize(n);}
mat3 basis(vec3 n){vec3 t=normalize(abs(n.z)<0.999?cross(n,vec3(0,0,1)):cross(n,vec3(1,0,0)));return mat3(t,cross(n,t),n);}
vec3 cosineDirection(vec3 n){float u=rnd(),phi=6.2831853*rnd(),r=sqrt(u);return basis(n)*vec3(r*cos(phi),r*sin(phi),sqrt(1.0-u));}
vec3 sphereOffset(){float z=2.0*rnd()-1.0,phi=6.2831853*rnd(),r=sqrt(max(1.0-z*z,0.0));return vec3(r*cos(phi),r*sin(phi),z);}
// Native light falloffs, as scene.frag: per-vertex world lighting (native) or the per-fragment model loop.
float lightContribution(int i,vec3 p,vec3 n,bool native,out vec3 target,out float range){
