    target=a.xyz;range=0.0;if(b.a<0.0)return 0.0;
    vec3 delta=a.xyz-p;float distance=length(delta);vec3 L;float attenuation;
    if(native){if(c.z>0.5)return 0.0;L=d.w==3.0?-d.xyz:delta/max(distance,0.0001);attenuation=d.w==3.0?1.0:(distance<=a.w?1.0/max(e.x+e.y*distance+e.z*distance*distance,0.0001):0.0);
        if(d.w==2.0){float rho=dot(-L,d.xyz);attenuation*=rho>=c.x?1.0:rho<=c.y?0.0:pow((rho-c.y)/max(c.x-c.y,0.0001),e.w);}
        if(d.w==3.0){target=p+L*g.eye.w;range=-1.0;}}
    else{if(c.z>0.5&&d.w==3.0)return 0.0;L=delta/max(distance,0.0001);attenuation=max(1.0-distance/max(a.w,0.0001),0.0);attenuation*=attenuation;}
    if(range==0.0)range=a.w;
    return luma(b.rgb*abs(b.a))*attenuation*max(dot(n,L),0.0);
}
vec3 hitRadiance(uint instanceIndex,uint geometryIndex,uint triangle,bool front,vec2 bary,mat4x3 transform){
    vec4 albedo=rtMaterialHit(instanceIndex,geometryIndex,triangle,front,bary,transform);if(albedo.a<=0.0)return vec3(0);
    RtInstance instance=rtInstances[instanceIndex];RtMaterial m=rtMaterials[instance.materialBase+geometryIndex];uint flags=m.metadata.x;
    if((flags&(64u|2048u|4096u))!=0u)return linear(albedo.rgb)*albedo.a; // Effect, explicit-material and unlit hits are already final.
    RtIndices indices=RtIndices(instance.indices);RtVertices vertices=RtVertices(instance.vertices);
    uint ia=indices.words[m.frames.z+triangle*3u],ib=indices.words[m.frames.z+triangle*3u+1u],ic=indices.words[m.frames.z+triangle*3u+2u];vec3 w=vec3(1.0-bary.x-bary.y,bary);
    vec3 p=transform*vec4(rtPosition(vertices,ia)*w.x+rtPosition(vertices,ib)*w.y+rtPosition(vertices,ic)*w.z,1);
    mat3 normalTransform=mat3(transform);for(int j=0;j<3;++j){float s=dot(normalTransform[j],normalTransform[j]);normalTransform[j]=s>0.0?normalTransform[j]/s:vec3(0);}
    vec3 n=rtSafeNormal(normalTransform*(rtNormal(vertices,ia)*w.x+rtNormal(vertices,ib)*w.y+rtNormal(vertices,ic)*w.z));if(!front)n=-n;
    vec3 illumination;
    if((flags&8192u)!=0u){uint a=ia*13u+8u,b=ib*13u+8u,c=ic*13u+8u;vec2 lm=vec2(vertices.words[a],vertices.words[a+1u])*w.x+vec2(vertices.words[b],vertices.words[b+1u])*w.y+vec2(vertices.words[c],vertices.words[c+1u])*w.z;
        illumination=2.0*clamp(textureLod(rtTextures[nonuniformEXT(uint(m.lightState.z))],lm,0).rgb+vec3(m.factors.z),0.0,1.0);}
    else illumination=vec3(m.factors.w);
    for(int i=0;i<int(g.camera.w);++i){vec4 a=lightData[i*5],b=lightData[i*5+1],d=lightData[i*5+2],e=lightData[i*5+3],c=lightData[i*5+4];if(b.a<0.0||c.z>0.5)continue;
        vec3 delta=a.xyz-p;float distance=length(delta);vec3 L=d.w==3.0?-d.xyz:delta/max(distance,0.0001);float attenuation=d.w==3.0?1.0:(distance<=a.w?1.0/max(e.x+e.y*distance+e.z*distance*distance,0.0001):0.0);
        if(d.w==2.0){float rho=dot(-L,d.xyz);attenuation*=rho>=c.x?1.0:rho<=c.y?0.0:pow((rho-c.y)/max(c.x-c.y,0.0001),e.w);}
        illumination+=clamp(b.rgb*abs(b.a)*attenuation,0.0,1.0)*max(dot(n,L),0.0);}
    return linear(albedo.rgb*illumination)*albedo.a;
}
// rtReflection with the transmitted fraction returned separately (the receiving color is not known here).
vec4 reflectionLayers(vec3 origin,vec3 direction,float maxDistance){
    vec3 radiance=vec3(0);float visibility=1.0,minDistance=.001;
    for(uint layer=0u;layer<rtInstances[0].padding&&minDistance<=maxDistance;++layer){
        rayQueryEXT q;rayQueryInitializeEXT(q,rtAcceleration,gl_RayFlagsNoneEXT,255,origin,minDistance,direction,maxDistance);
        while(rayQueryProceedEXT(q))if(rayQueryGetIntersectionTypeEXT(q,false)==gl_RayQueryCandidateIntersectionTriangleEXT){vec4 color=rtHitColor(q,false);if(color.a>0.0)rayQueryConfirmIntersectionEXT(q);}
        if(rayQueryGetIntersectionTypeEXT(q,true)==gl_RayQueryCommittedIntersectionNoneEXT)break;
        vec4 color=rtHitColor(q,true);float alpha=clamp(color.a,0.0,1.0);
        uint flags=rtMaterials[rtInstances[rayQueryGetIntersectionInstanceCustomIndexEXT(q,true)].materialBase+rayQueryGetIntersectionGeometryIndexEXT(q,true)].metadata.x;
        radiance+=visibility*alpha*color.rgb;if((flags&(512u|1024u))!=(512u|1024u))visibility*=1.0-alpha;if(visibility<=0.0)break;
        minDistance=uintBitsToFloat(floatBitsToUint(rayQueryGetIntersectionTEXT(q,true))+1u);
    }
    return vec4(radiance,visibility);
}
layout(constant_id=0) const bool k22SmoothNormals=false;
// smooth_normals: shadow-terminator origin (Hanika 2021). Smoothed low-poly models are shaded with vertex normals but
// traced against flat triangles, so rays leaving a facet near the terminator re-enter neighbouring facets: blocky
// self-shadow. The camera ray re-finds the base-mesh triangle under the pixel (tessellated pixels within the PN bulge
// `slack`); the origin is lifted onto the surface its vertex normals describe (outward projection onto each vertex
// tangent plane, weighted by the barycentrics), then offset along the camera-facing geometric normal against acne.
vec3 terminatorOrigin(vec3 p,float bias,vec3 fallback){
    vec3 toward=p-g.eye.xyz;float len=length(toward),slack=max(bias*4.0,len*0.004);if(len<=slack)return fallback;
    rayQueryEXT q;rayQueryInitializeEXT(q,rtAcceleration,gl_RayFlagsNoneEXT,255,g.eye.xyz,len-slack,toward/len,len+slack);
    while(rayQueryProceedEXT(q))if(rayQueryGetIntersectionTypeEXT(q,false)==gl_RayQueryCandidateIntersectionTriangleEXT&&rtHitColor(q,false).a>=0.5)rayQueryConfirmIntersectionEXT(q);
    if(rayQueryGetIntersectionTypeEXT(q,true)==gl_RayQueryCommittedIntersectionNoneEXT)return fallback;
    RtInstance instance=rtInstances[rayQueryGetIntersectionInstanceCustomIndexEXT(q,true)];RtMaterial m=rtMaterials[instance.materialBase+rayQueryGetIntersectionGeometryIndexEXT(q,true)];
    RtIndices indices=RtIndices(instance.indices);RtVertices vertices=RtVertices(instance.vertices);uint first=m.frames.z+rayQueryGetIntersectionPrimitiveIndexEXT(q,true)*3u;
    mat4x3 transform=rayQueryGetIntersectionObjectToWorldEXT(q,true);
    mat3 normalTransform=mat3(transform);for(int j=0;j<3;++j){float s=dot(normalTransform[j],normalTransform[j]);normalTransform[j]=s>0.0?normalTransform[j]/s:vec3(0);}
    vec2 bary=rayQueryGetIntersectionBarycentricsEXT(q,true);vec3 w=vec3(1.0-bary.x-bary.y,bary),v[3],vn[3];
    for(uint j=0u;j<3u;++j){uint id=indices.words[first+j];v[j]=transform*vec4(rtPosition(vertices,id),1);vn[j]=rtSafeNormal(normalTransform*rtNormal(vertices,id));}
    vec3 hit=v[0]*w.x+v[1]*w.y+v[2]*w.z,facet=rtSafeNormal(cross(v[1]-v[0],v[2]-v[0]));if(dot(facet,g.eye.xyz-hit)<0.0)facet=-facet;
    vec3 lifted=hit;for(int j=0;j<3;++j){vec3 nj=dot(vn[j],facet)<0.0?-vn[j]:vn[j];lifted-=w[j]*min(dot(hit-v[j],nj),0.0)*nj;}
    return lifted+facet*bias;
}
void main(){
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);if(pixel.x>=g.config.y||pixel.y>=g.config.z)return;
    seed=pcg(uint(pixel.x)+uint(pixel.y)*uint(g.config.y))^pcg(uint(g.params.x)*9781u+1u);
    float depth=texelFetch(gDepth,pixel,0).r;vec4 data=texelFetch(gData,pixel,0);int flags=int(data.a+0.5);
    vec4 mask=vec4(1),gi=vec4(0,0,0,1),reflection=vec4(0,0,0,1);
    if(depth<1.0){
        vec2 uv=(vec2(pixel)+0.5)/vec2(g.config.yz);vec4 world=g.inverseViewProjection*vec4(uv.x*2.0-1.0,1.0-uv.y*2.0,depth*2.0-1.0,1.0);vec3 p=world.xyz/world.w,n=decodeNormal(data.xy);
