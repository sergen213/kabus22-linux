#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Base { float base[]; };
layout(set=0,binding=1,std430) readonly buffer First { float first[]; };
layout(set=0,binding=2,std430) readonly buffer Next { float next[]; };
layout(set=0,binding=3,std430) writeonly buffer Output { float outputPose[]; };
layout(push_constant) uniform PoseParameters { uint count; uint firstOffset; uint nextOffset; float blend; uint nextFallback; } pose;
void main(){
    uint i=gl_GlobalInvocationID.x;if(i>=pose.count)return;
    uint dst=i*13u,a=pose.firstOffset+i*9u,b=pose.nextOffset+i*9u;
    for(uint j=0u;j<6u;++j){bool fallback=(pose.nextFallback&(j<3u?1u:2u))!=0u;outputPose[dst+j]=mix(first[a+j],fallback?first[a+j]:next[b+j],pose.blend);}
    for(uint j=6u;j<10u;++j)outputPose[dst+j]=base[dst+j];
    for(uint j=0u;j<3u;++j)outputPose[dst+10u+j]=mix(first[a+6u+j],next[b+6u+j],pose.blend);
}
